# LiteLLM authentication
LITELLM_MASTER_KEY=sk-litellm-master-change-me

# Mem0 gateway upstream (gateway -> LiteLLM)
# Start with the master key, then replace with a generated virtual key.
UPSTREAM_BASE_URL=http://litellm:4000
UPSTREAM_API_KEY=sk-litellm-master-change-me
UPSTREAM_HEADERS={}

# LiteLLM persistence (required for key management/budgets)
DATABASE_URL=postgresql://litellm:litellm@litellm-db:5432/litellm

# OpenRouter upstream (LiteLLM -> OpenRouter)
OPENROUTER_API_KEY=change-me
OPENROUTER_HTTP_REFERER=http://localhost:3080
OPENROUTER_X_TITLE=LibreChat
