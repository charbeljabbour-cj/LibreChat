USER=default_user

# Set to your OpenRouter key (used for embeddings and fact extraction)
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Vector store
QDRANT_HOST=mem0-store
QDRANT_PORT=6333

# Memory engine version
MEM0_VERSION=v1.1

# Graph store (Neo4j) — connects OpenMemory to the Neo4j service for
# knowledge-graph relationships between memories.
MEM0_GRAPH_STORE_JSON={"provider":"neo4j","config":{"url":"neo4j://neo4j:7687","username":"neo4j","password":"change-me"}}

# Optional reranker (LLM-based via OpenRouter)
# MEM0_RERANKER_JSON={"provider":"llm_reranker","config":{"llm":{"provider":"openai","config":{"model":"openai/gpt-4.1-mini","api_key":"env:OPENAI_API_KEY"}}}}

# Optional prompt overrides. Runtime safety appends required JSON schema hints.
# MEM0_CUSTOM_FACT_EXTRACTION_PROMPT=
# MEM0_CUSTOM_UPDATE_MEMORY_PROMPT=
