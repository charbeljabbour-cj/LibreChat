USER=default_user
OPENAI_API_KEY=change-me

# For OpenRouter, keep OPENAI_API_KEY set to your OpenRouter key
# and uncomment the base URL override below.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Vector store
QDRANT_HOST=mem0-store
QDRANT_PORT=6333

# Optional Mem0 advanced config (JSON values)
# MEM0_GRAPH_STORE_JSON={"provider":"neo4j","config":{"url":"neo4j://neo4j:7687","username":"neo4j","password":"change-me"}}
# MEM0_RERANKER_JSON={"provider":"llm_reranker","config":{"llm":{"provider":"openai","config":{"model":"openai/gpt-5-mini","api_key":"env:OPENAI_API_KEY"}}}}
# COHERE_API_KEY=change-me
# MEM0_RERANKER_JSON={"provider":"cohere","config":{"api_key":"env:COHERE_API_KEY","model":"rerank-english-v3.0"}}
# MEM0_VERSION=v1.1
# Optional prompt overrides. Runtime safety appends required JSON schema hints.
# MEM0_CUSTOM_FACT_EXTRACTION_PROMPT=
# MEM0_CUSTOM_UPDATE_MEMORY_PROMPT=
