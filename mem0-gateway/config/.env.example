PORT=8001
BODY_LIMIT=25mb

# Gateway auth (LibreChat -> gateway)
GATEWAY_API_KEY=change-me

# Upstream model provider (gateway -> model API)
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=change-me
# Optional JSON string of extra headers
# UPSTREAM_HEADERS={"X-Custom-Header":"value"}

# Memory backend
MEM0_ENABLED=true
# platform, oss, openmemory, or mem0_compat
MEM0_MODE=mem0_compat
MEM0_API_BASE=http://openmemory-api:8765
MEM0_API_KEY=
MEM0_API_FLAVOR=mem0_v2
MEM0_SEARCH_TOP_K=6
MEM0_MAX_MEMORIES=6
MEM0_THRESHOLD=0.3
MEM0_SEARCH_THRESHOLD=0.3
MEM0_SEARCH_RERANK=false
MEM0_ENABLE_GRAPH=false
MEM0_INCLUDE_RELATIONS_IN_PROMPT=true
MEM0_KEYWORD_SEARCH=false
MEM0_FILTER_MEMORIES=false
MEM0_SEARCH_FIELDS=[]
MEM0_SEARCH_FILTERS={}
MEM0_STORE_MODE=user_only
MEM0_STORE_STRATEGY=all
MEM0_INJECT_ROLE=system
MEM0_ASYNC_MODE=true
MEM0_OUTPUT_FORMAT=v1.1
MEM0_VERSION=v1.1
MEM0_MEMORY_TYPE=
MEM0_PROMPT=
MEM0_CUSTOM_CATEGORIES=
MEM0_IMMUTABLE=false
MEM0_TIMESTAMP_MODE=none
MEM0_EXPIRATION_DATE=
MEM0_MULTIMODAL_ENABLED=true
MEM0_MAX_IMAGE_BYTES=20971520
MEM0_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif
MEM0_ADD_RETRIES=2
MEM0_ADD_RETRY_DELAY_MS=500
MEM0_FORGET_ENABLED=true
MEM0_FORGET_MAX_DELETIONS=20
MEM0_FORGET_MIN_SCORE=0
MEM0_FORGET_PASSES=2
MEM0_FORGET_SETTLE_MS=1200

MEM0_AGENT_ID=
MEM0_RUN_ID=
MEM0_APP_ID=
MEM0_ORG_ID=
MEM0_PROJECT_ID=
MEM0_USE_CONVERSATION_AS_RUN_ID=false

# Optional prompt overrides. Safety hints for required JSON response shape are appended automatically.
MEM0_CUSTOM_FACT_EXTRACTION_PROMPT=
MEM0_CUSTOM_UPDATE_MEMORY_PROMPT=

# Leave empty to use per-request X-User-Id from LibreChat
OPENMEMORY_USER_ID=
OPENMEMORY_APP=librechat
OPENMEMORY_APP_INCLUDE_USER_ID=true
OPENMEMORY_INFER=true

# Timeouts
UPSTREAM_TIMEOUT_MS=120000
MEM0_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=info

# Optional: model list for /v1/models
# AVAILABLE_MODELS=gpt-4.1-mini,gpt-4o-mini
